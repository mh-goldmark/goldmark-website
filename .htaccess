<FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
SetHandler application/x-lsphp74
</FilesMatch>

RewriteEngine On
RewriteOptions inherit
Options +FollowSymlinks
Options -Multiviews
Options All -Indexes
ErrorDocument 404 /404.php

RewriteCond %{HTTP_HOST} !=""
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTPS}s ^on(s)|
RewriteRule ^ http%1://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html

RewriteBase /

#STATIC PAGES PAGE RE-WRITE

#About Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about-gold-mark-real-estate.html\/?$ about.php [L]

#Contact Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contact-gold-mark-real-estate.html\/?$ contact.php [L]

#Media Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^gold-mark-real-estate-media.html\/?$ media.php [L]

#List a Property Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^gold-mark-real-estate-list-property.html\/?$ list.php [L]

#Teams Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^gold-mark-real-estate-team.html\/?$ experts.php [L]

#Career Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^gold-mark-real-estate-career.html\/?$ career.php [L]

#Terms and Conditions Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^terms-and-conditions.html\/?$ terms.php [L]

#Privacy Policy Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^privacy-policy.html\/?$ policy.php [L]

#Website Cookies Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^website-cookies.html\/?$ cookies.php [L]

#Popular Communities Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^communities.html\/?$ communities.php [L]

#New Developments Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^developments.html\/?$ developments.php [L]

#Listings Map Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^map.html\/?$ map.php [L]

#Projects Map Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^projects/map.html$ map.php?category=Projects [L]

#DYNAMIC PAGES PAGE RE-WRITE

#RESIDENTIALS
#Residentials for Sale Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^residentials-for-sale.html\/?$ properties.php?category=Residential&class=Sale [L]

#Residentials for Rent Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^residentials-for-rent.html\/?$ properties.php?category=Residential&class=Rent [L]

