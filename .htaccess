#MISCELLANEOUS

#Residential Details Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^residentials/.*-(\d+)\.html$ property.php?id=$1 [L]

#Commercial Details Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^commercials/.*-(\d+)\.html$ property.php?id=$1 [L]

#Project Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^new-developments/.*-(\d+)\.html$ project.php?id=$1 [L]

#Short URL Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^go/([A-Za-z0-9-()]+)$ details.php?id=$1 [L]

#Community Details Page Re-write
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^community-guides/.*-(\d+)\.html$ community.php?id=$1 [L]

#Team Page Re-write
